# Puerta de entrada en produccion. Hace lo mismo que el proxy de Vite en
# desarrollo (frontend/vite.config.ts): /api y /ws van al backend, el resto es
# la web compilada.
#
# DOMINIO sale de deploy/.env:
#   - un dominio real (ej. colabmodel.duckdns.org) -> Caddy saca y renueva solo
#     el certificado HTTPS. El dictado por voz del navegador EXIGE HTTPS.
#   - ":80" -> solo HTTP, para probar en una maquina local sin dominio.

{$DOMINIO} {
	encode gzip

	# API REST y Swagger
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /swagger-ui* {
		reverse_proxy backend:8080
	}
	handle /v3/api-docs* {
		reverse_proxy backend:8080
	}

	# Colaboracion en vivo (STOMP sobre SockJS). Caddy pasa el WebSocket solo.
	handle /ws* {
		reverse_proxy backend:8080
	}

	# La web (React). Cualquier otra ruta cae en index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
