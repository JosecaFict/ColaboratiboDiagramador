# Copiar a deploy/.env y completar. deploy/.env NO se sube a git (.gitignore).

# --- Acceso ------------------------------------------------------------------
# El dominio que apunta a la IP de la EC2 (ej. colabmodel.duckdns.org).
# Con un dominio real Caddy pone HTTPS solo. Para probar sin dominio: DOMINIO=:80
DOMINIO=colabmodel.duckdns.org

# --- Secretos (generarlos con: openssl rand -base64 48) ----------------------
DB_PASSWORD=cambiar-por-una-clave-larga
# Minimo 32 caracteres. Si cambia, todos tienen que volver a iniciar sesion.
JWT_SECRET=cambiar-por-una-clave-larga-de-al-menos-32-caracteres

# --- IA ----------------------------------------------------------------------
# ollama -> la IA local de la PC con la RTX 3070, por Tailscale.
# gemini -> plan B en la nube (clave gratuita de aistudio.google.com).
IA_PROVEEDOR=ollama
# IP de Tailscale de la PC con Ollama (comando: tailscale ip -4).
OLLAMA_URL=http://100.83.228.76:11434

# Lectura de diagramas desde imagen (nivel 2b):
#   claude -> necesita ANTHROPIC_API_KEY; sin clave, se detecta igual pero sin leer los textos
#   gemini -> necesita GEMINI_API_KEY
#   local  -> Ollama en la PC; necesita el modelo qwen2.5vl:3b descargado
VISION_PROVEEDOR=gemini

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
